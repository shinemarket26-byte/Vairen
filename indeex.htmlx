<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080711">
<title>Vairen Alren — Link Universe</title>
<style>
:root{--bg:#080711;--panel:#0c0b18e8;--violet:#b7a0ff;--glow:#8d69ff;--white:#f4f0ff;--muted:#a9a1c8;--line:#b6a0ff45}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--white);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100vh;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-3;background:radial-gradient(ellipse at 50% 40%,#29204e 0,#100d20 40%,#05050b 100%)}
body:after{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;opacity:.24;background-image:linear-gradient(#bca7ff09 1px,transparent 1px),linear-gradient(90deg,#bca7ff09 1px,transparent 1px);background-size:45px 45px;mask-image:linear-gradient(to bottom,black,transparent 90%)}
a{color:inherit;text-decoration:none}button{font:inherit}
.particles{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.particles span{position:absolute;width:3px;height:3px;background:#d8ccff;border-radius:50%;box-shadow:0 0 13px #a88bff;animation:drift 9s linear infinite}
.particles span:nth-child(1){left:8%;top:80%;animation-delay:-2s}.particles span:nth-child(2){left:20%;top:30%;animation-delay:-5s}.particles span:nth-child(3){left:75%;top:70%;animation-delay:-1s}.particles span:nth-child(4){left:88%;top:22%;animation-delay:-6s}.particles span:nth-child(5){left:60%;top:12%;animation-delay:-3s}.particles span:nth-child(6){left:44%;top:85%;animation-delay:-7s}.particles span:nth-child(7){left:95%;top:55%;animation-delay:-4s}
@keyframes drift{0%{transform:translateY(25px);opacity:0}25%{opacity:1}100%{transform:translateY(-100px);opacity:0}}
header{height:86px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,4vw,58px);border-bottom:1px solid #b6a0ff1c;background:#0807119c;backdrop-filter:blur(14px)}
.logo{font-size:clamp(18px,2vw,28px);font-weight:900;letter-spacing:.13em;text-shadow:0 0 22px #b7a0ff55}.logo span{display:block;font-size:8px;letter-spacing:.38em;color:var(--muted);margin-top:6px}
.header-right{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:10px;letter-spacing:.22em}
.pulse{display:inline-block;width:6px;height:6px;border-radius:50%;background:#b6ffa9;box-shadow:0 0 10px #b6ffa9;margin-right:8px}
main{max-width:1400px;margin:auto;padding:30px clamp(14px,3vw,42px) 24px}
.hero{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,2fr);gap:25px;align-items:center;min-height:220px;margin-bottom:24px}
.eyebrow{font-size:9px;letter-spacing:.34em;color:var(--violet);text-transform:uppercase}
h1{font-size:clamp(34px,6vw,72px);line-height:.92;letter-spacing:-.065em;margin:14px 0 14px;text-shadow:0 0 30px #8d69ff28}
h1 span{display:block;color:transparent;-webkit-text-stroke:1px #c5b5ff}
.intro{color:var(--muted);font-size:13px;line-height:1.8;max-width:360px}
.hero-art{height:225px;position:relative;overflow:hidden;border:1px solid var(--line);border-radius:20px;background:linear-gradient(110deg,#0a0915,#1b1433 55%,#080711);display:flex;align-items:center;justify-content:center}
.hero-art:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#080711e8,transparent 48%,#08071188),url("assets/discord.jpg") center 35%/cover;opacity:.38;filter:saturate(.7)}
.hero-art:after{content:"";position:absolute;inset:10px;border:1px solid #c4b3ff25;border-radius:14px;pointer-events:none}
.hero-quote{position:relative;z-index:1;text-align:center;font-size:clamp(15px,2.5vw,28px);letter-spacing:.16em;text-transform:uppercase;text-shadow:0 0 18px #a98aff}
.hero-quote small{display:block;font-size:9px;color:var(--muted);letter-spacing:.3em;margin-top:12px}
.hero-mark{position:absolute;right:22px;bottom:16px;color:#bbaaff;font-size:25px;opacity:.7}
.menu-heading{display:flex;justify-content:space-between;align-items:end;margin:32px 0 14px}
.menu-heading h2{margin:7px 0 0;font-size:18px;letter-spacing:.19em}
.hint{font-size:10px;color:var(--muted);letter-spacing:.13em}.carousel-controls{display:flex;align-items:center;gap:8px}.mode-switch{display:flex;border:1px solid var(--line);border-radius:99px;padding:3px;background:#080711b8;margin-right:5px}.mode-btn{border:0;background:transparent;color:var(--muted);padding:7px 10px;border-radius:99px;font-size:9px;letter-spacing:.12em;cursor:pointer}.mode-btn.selected{background:#8d69ff35;color:#eee6ff;box-shadow:0 0 14px #8d69ff20}.arrow-btn:disabled{opacity:.28;cursor:default;box-shadow:none}
.carousel-wrap{position:relative}
.carousel{display:flex;gap:17px;overflow:hidden;padding:12px 5px 24px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#7662b8 transparent;overscroll-behavior-x:contain;touch-action:pan-y;}
.carousel::-webkit-scrollbar{height:5px}.carousel::-webkit-scrollbar-thumb{background:#7662b8;border-radius:8px}
.card{--accent:#b7a0ff;position:relative;flex:0 0 clamp(225px,24%,285px);height:425px;scroll-snap-align:center;border:1px solid #b6a0ff55;border-radius:13px;overflow:hidden;background:#0b0915;isolation:isolate;transition:transform .4s,border-color .4s,box-shadow .4s;transform:translateY(8px);opacity:.83}
.card:hover,.card.active{transform:translateY(-5px);opacity:1;border-color:#d4c8ff;box-shadow:0 0 0 1px #b7a0ff25,0 0 32px #7857ff40}
.card:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(to bottom,transparent 8%,#09071210 36%,#090712c9 67%,#090712f8 100%),var(--card-image) center 24%/cover no-repeat;transition:transform .65s,filter .4s;filter:saturate(.92)}
.card:hover:before,.card.active:before{transform:scale(1.06);filter:saturate(1.1)}
.card:after{content:"";position:absolute;inset:7px;border:1px solid #b6a0ff2b;pointer-events:none;border-radius:8px}
.card-top{position:absolute;top:17px;left:16px;right:16px;display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:.2em;color:#dcd3ff}
.card-icon{font-size:21px;text-shadow:0 0 16px var(--accent)}
.card-content{position:absolute;left:18px;right:18px;bottom:24px;text-align:center}
.card-content h3{margin:0 0 10px;font-size:20px;letter-spacing:.18em;text-transform:uppercase;text-shadow:0 0 18px #a88bff88}
.card-content p{margin:0 auto 20px;max-width:190px;font-size:12px;line-height:1.6;color:#d0c8e7;min-height:38px}
.go{display:inline-flex;align-items:center;justify-content:center;gap:15px;border:1px solid #b6a0ff8c;padding:8px 17px;min-width:95px;border-radius:2px;font-size:9px;letter-spacing:.2em;transition:.25s;background:#110d22aa}
.go:hover{background:#a78aff24;box-shadow:0 0 20px #8d69ff42;letter-spacing:.28em}
.card-num{position:absolute;right:17px;top:47px;font-size:9px;color:#e6ddff90;letter-spacing:.15em}
.arrows{display:flex;gap:8px}
.arrow-btn{width:37px;height:37px;border:1px solid var(--line);background:#ffffff08;color:#ded2ff;border-radius:50%;cursor:pointer;font-size:19px;transition:.2s}
.arrow-btn:hover{background:#b6a0ff20;box-shadow:0 0 18px #8d69ff40}
.dots{display:flex;justify-content:center;gap:8px;margin-top:-5px}
.dots button{width:5px;height:5px;padding:0;border:0;border-radius:50%;background:#55496f;cursor:pointer}
.dots button.on{background:#d0c0ff;box-shadow:0 0 10px #b7a0ff;width:18px;border-radius:8px}
.info-row{display:grid;grid-template-columns:1.3fr .7fr;gap:15px;margin-top:28px}
.info-panel{border:1px solid var(--line);background:linear-gradient(110deg,#110e20dc,#090811c9);padding:21px;border-radius:12px;position:relative;overflow:hidden}
.info-panel h3{font-size:11px;letter-spacing:.28em;color:var(--violet);margin:0 0 12px}
.info-panel p{font-size:12px;line-height:1.8;color:var(--muted);margin:0}
.about-name{font-size:21px;color:#fff;margin-bottom:5px!important;letter-spacing:.07em}
.butterfly{position:absolute;right:20px;top:20px;font-size:45px;color:#bbaaff20}
footer{display:flex;justify-content:space-between;align-items:center;gap:15px;max-width:1400px;margin:auto;padding:20px clamp(18px,4vw,58px);border-top:1px solid #b6a0ff22;color:#77718f;font-size:9px;letter-spacing:.15em}
.footer-links{display:flex;gap:18px;flex-wrap:wrap}.footer-links a:hover{color:#d9ceff}
.fade-out{animation:fadeOut .22s ease forwards}.fade-in{animation:fadeIn .42s ease forwards}
@keyframes fadeOut{to{opacity:0;transform:translateY(10px) scale(.985);filter:blur(5px)}}
@keyframes fadeIn{from{opacity:0;transform:translateY(14px) scale(.985);filter:blur(5px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}
@media(max-width:800px){header{height:72px}.hero{grid-template-columns:1fr;gap:16px}.hero-art{height:155px}.hero-copy{padding:5px 4px}.card{flex-basis:68%;height:330px}.info-row{grid-template-columns:1fr}.menu-heading h2{font-size:16px}.hint{max-width:130px;text-align:right;line-height:1.6}}
@media(max-width:430px){.header-right{font-size:8px;letter-spacing:.1em}.hero-art{height:130px}.card{flex-basis:78%;height:320px}.menu-heading{align-items:center}.info-panel{padding:17px}footer{align-items:flex-start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="particles"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
<header>
  <a class="logo" href="#home">VAIREN ALREN<span>ONE SOUL, MANY VERSIONS ✦</span></a>
  <div class="header-right"><span><i class="pulse"></i>ONLINE UNIVERSE</span><span>✧ 2026</span></div>
</header>
<main id="home">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">✦ Welcome to my world</div>
      <h1>VAIREN <span>ALREN.</span></h1>
      <p class="intro">Bukan sekadar link, tapi jalan untuk tetap terhubung dengan dunia kecilku. Gaming, cerita, dan perjalanan yang terus berjalan.</p>
    </div>
    <div class="hero-art">
      <div class="hero-quote">Choose your destination<small>SCROLL · SWIPE · EXPLORE</small></div>
      <div class="hero-mark">✧ 蝶</div>
    </div>
  </section>

  <section id="links">
    <div class="menu-heading">
      <div><div class="eyebrow">/ Main menu</div><h2>ENTER MY WORLD</h2></div>
      <div class="carousel-controls"><div class="mode-switch" role="group" aria-label="Cara navigasi"><button class="mode-btn selected" id="buttonMode" type="button">TOMBOL</button><button class="mode-btn" id="swipeMode" type="button">SWIPE</button></div><button class="arrow-btn" id="prevBtn" type="button" aria-label="Kartu sebelumnya">‹</button><button class="arrow-btn" id="nextBtn" type="button" aria-label="Kartu berikutnya">›</button></div>
    </div>
    <div class="carousel-wrap">
      <div class="carousel" id="carousel">
        <article class="card" style="--card-image:url('assets/tiktok.jpg')">
          <div class="card-top"><span>01 / CHANNEL</span><span class="card-icon">♪</span></div><span class="card-num">VA-01</span>
          <div class="card-content"><h3>TikTok</h3><p>Live gaming, clips, and moments from my day.</p><a class="go" href="https://www.tiktok.com/@YOURUSERNAME" target="_blank" rel="noopener">OPEN ↗</a></div>
        </article>
        <article class="card" style="--card-image:url('assets/youtube.jpg')">
          <div class="card-top"><span>02 / VIDEOS</span><span class="card-icon">▶</span></div><span class="card-num">VA-02</span>
          <div class="card-content"><h3>YouTube</h3><p>Highlights, videos, and stories worth keeping.</p><a class="go" href="https://www.youtube.com/@YOURUSERNAME" target="_blank" rel="noopener">OPEN ↗</a></div>
        </article>
        <article class="card active" style="--card-image:url('assets/discord.jpg')">
          <div class="card-top"><span>03 / COMMUNITY</span><span class="card-icon">⌘</span></div><span class="card-num">VA-03</span>
          <div class="card-content"><h3>Discord</h3><p>Join the server and hang out with us.</p><a class="go" href="https://discord.gg/YOURINVITE" target="_blank" rel="noopener">OPEN ↗</a></div>
        </article>
        <article class="card" style="--card-image:url('assets/sociabuzz.jpg')">
          <div class="card-top"><span>04 / SUPPORT</span><span class="card-icon">♡</span></div><span class="card-num">VA-04</span>
          <div class="card-content"><h3>Sociabuzz</h3><p>Your support helps me keep creating.</p><a class="go" href="https://sociabuzz.com/YOURUSERNAME/tribe" target="_blank" rel="noopener">SUPPORT ↗</a></div>
        </article>
        <article class="card" style="--card-image:url('assets/instagram.jpg')">
          <div class="card-top"><span>05 / GALLERY</span><span class="card-icon">◎</span></div><span class="card-num">VA-05</span>
          <div class="card-content"><h3>Instagram</h3><p>Daily life, updates, and behind the scenes.</p><a class="go" href="https://www.instagram.com/YOURUSERNAME" target="_blank" rel="noopener">OPEN ↗</a></div>
        </article>
        <article class="card" style="--card-image:url('assets/contact.jpg')">
          <div class="card-top"><span>06 / CONTACT</span><span class="card-icon">✉</span></div><span class="card-num">VA-06</span>
          <div class="card-content"><h3>Contact</h3><p>For collaboration, projects, or saying hello.</p><a class="go" href="mailto:YOURMAIL@example.com">MESSAGE ↗</a></div>
        </article>
      </div>
      <div class="dots" id="dots" aria-label="Pilih kartu"></div>
    </div>
  </section>

  <section class="info-row" id="about">
    <div class="info-panel"><span class="butterfly">蝶</span><h3>ABOUT THE CHARACTER</h3><p class="about-name">Vairen Alren</p><p>Hati yang dingin, pikiran yang kacau, dan mimpi yang belum selesai. Terima kasih sudah mampir ke sudut kecil dunia gue.</p></div>
    <div class="info-panel"><h3>A LITTLE REMINDER</h3><p>“Small steps still get you closer to your dreams.”<br><br><span style="color:#d7caff">— Vairen Alren</span></p></div>
  </section>
</main>
<footer><span>© <span id="year"></span> VAIREN ALREN · MADE WITH ♡ & A LITTLE DARKNESS</span><div class="footer-links"><a href="#home">HOME</a><a href="#links">LINKS</a><a href="#about">ABOUT</a><a href="mailto:YOURMAIL@example.com">CONTACT</a></div></footer>
<script>
/* =================== EDIT LINK DI SINI ===================
   Ganti YOURUSERNAME, YOURINVITE, dan YOURMAIL pada link HTML.
   Untuk gambar, ganti file di folder assets dengan pose PNG/WebP Vairen.
=========================================================== */
const carousel = document.getElementById('carousel');
const cards = [...document.querySelectorAll('.card')];
const dots = document.getElementById('dots');
const buttonMode = document.getElementById('buttonMode');
const swipeMode = document.getElementById('swipeMode');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
let navMode = 'buttons';
let activeIndex = 2;
let isAnimating = false;
document.getElementById('year').textContent = new Date().getFullYear();

cards.forEach((card, i) => {
  const dot = document.createElement('button');
  dot.type = 'button';
  dot.setAttribute('aria-label', `Pilih kartu ${i+1}`);
  dot.addEventListener('click', () => goTo(i));
  dots.appendChild(dot);
});

function setMode(mode) {
  navMode = mode;
  buttonMode.classList.toggle('selected', mode === 'buttons');
  swipeMode.classList.toggle('selected', mode === 'swipe');
  carousel.style.overflowX = mode === 'swipe' ? 'auto' : 'hidden';
  carousel.style.touchAction = mode === 'swipe' ? 'pan-x pan-y' : 'pan-y';
  carousel.style.scrollBehavior = mode === 'swipe' ? 'smooth' : 'auto';
  if (mode === 'buttons') {
    carousel.scrollTo({left: 0, behavior: 'auto'});
    goTo(activeIndex, true);
  }
}
buttonMode.addEventListener('click', () => setMode('buttons'));
swipeMode.addEventListener('click', () => setMode('swipe'));

function updateActive(index) {
  if (typeof index === 'number') activeIndex = index;
  cards.forEach((card, i) => {
    card.classList.toggle('active', i === activeIndex);
    card.style.order = '';
  });
  [...dots.children].forEach((dot, i) => dot.classList.toggle('on', i === activeIndex));
  prevBtn.disabled = activeIndex === 0;
  nextBtn.disabled = activeIndex === cards.length - 1;
}
function goTo(index, immediate = false) {
  index = Math.max(0, Math.min(cards.length - 1, index));
  if (isAnimating && !immediate) return;
  isAnimating = true;
  const oldCard = cards[activeIndex];
  const newCard = cards[index];
  if (oldCard && oldCard !== newCard) oldCard.classList.add('fade-out');
  setTimeout(() => {
    cards.forEach(card => card.classList.remove('fade-out', 'fade-in'));
    activeIndex = index;
    updateActive(index);
    if (navMode === 'swipe') {
      const left = newCard.offsetLeft - (carousel.clientWidth - newCard.clientWidth) / 2;
      carousel.scrollTo({left, behavior: 'smooth'});
    } else {
      // In button mode, move the chosen card to the center without free scrolling.
      const gap = parseFloat(getComputedStyle(carousel).gap) || 17;
      const cardWidth = newCard.getBoundingClientRect().width;
      const targetLeft = Math.max(0, index * (cardWidth + gap) - (carousel.clientWidth - cardWidth) / 2);
      carousel.scrollTo({left: targetLeft, behavior: immediate ? 'auto' : 'smooth'});
    }
    newCard.classList.add('fade-in');
    setTimeout(() => {
      newCard.classList.remove('fade-in');
      isAnimating = false;
    }, 450);
  }, immediate ? 0 : 190);
}
prevBtn.addEventListener('click', () => goTo(activeIndex - 1));
nextBtn.addEventListener('click', () => goTo(activeIndex + 1));

let scrollTimer;
carousel.addEventListener('scroll', () => {
  if (navMode !== 'swipe') return;
  clearTimeout(scrollTimer);
  scrollTimer = setTimeout(() => {
    let best = 0, distance = Infinity;
    const center = carousel.getBoundingClientRect().left + carousel.clientWidth / 2;
    cards.forEach((card, i) => {
      const rect = card.getBoundingClientRect();
      const d = Math.abs(center - (rect.left + rect.width / 2));
      if (d < distance) { distance = d; best = i; }
    });
    updateActive(best);
  }, 130);
});

// Swipe is disabled unless the user explicitly chooses SWIPE.
let touchStartX = 0;
carousel.addEventListener('touchstart', e => {
  if (navMode === 'swipe') touchStartX = e.changedTouches[0].screenX;
}, {passive:true});
carousel.addEventListener('touchend', e => {
  if (navMode !== 'swipe') return;
  const diff = touchStartX - e.changedTouches[0].screenX;
  if (Math.abs(diff) > 90) goTo(activeIndex + (diff > 0 ? 1 : -1));
}, {passive:true});

setMode('buttons');
updateActive(activeIndex);
</script>
</body>
</html>
